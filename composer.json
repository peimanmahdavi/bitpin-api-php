{
    "name": "zedxpm/bitpin-api-php",
    "description": "Official PHP SDK for Bitpin Exchange API - Laravel compatible with Guzzle HTTP client",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "bitpin",
        "exchange",
        "crypto",
        "api",
        "laravel",
        "guzzle"
    ],
    "authors": [
        {
            "name": "pmzedx",
            "email": "peimanmahdavi9@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.12"
    },
    "autoload": {
        "psr-4": {
            "Bitpin\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bitpin\\Api\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bitpin\\Api\\BitpinServiceProvider"
            ],
            "aliases": {
                "Bitpin": "Bitpin\\Api\\Facades\\Bitpin"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}