# Bitpin API Configuration
# Copy this to .env and fill in your values

# Required: API Credentials from Bitpin website/app (API section)
BITPIN_API_KEY=your_api_key_here
BITPIN_SECRET_KEY=your_secret_key_here

# API URLs
BITPIN_BASE_URL=https://api.bitpin.org
BITPIN_WEBSOCKET_URL=wss://centrifugo.bitpin.org/connection/websocket

# HTTP Client Settings
BITPIN_TIMEOUT=30
BITPIN_CONNECT_TIMEOUT=10
BITPIN_RETRIES=3
BITPIN_RETRY_DELAY=1000

# Token Management
# Access tokens expire in 15 minutes, refresh tokens in 30 days
BITPIN_AUTO_REFRESH_TOKEN=true
BITPIN_TOKEN_REFRESH_BUFFER=60

# Logging (optional)
BITPIN_LOGGING_ENABLED=false
BITPIN_LOG_CHANNEL=default
BITPIN_LOG_LEVEL=debug